# Copy to .env.local for local development. Never commit populated secrets.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=gurukul_academy
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
# Set this to the canonical public HTTPS origin before production deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional email notifications via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=shrigurukulnewlepa@gmail.com
# Optional live Google Sheets sync for contact and admission enquiries.
# Share the target spreadsheet with this service-account email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_CONTACT_SHEET_TAB="Contact Enquiries"
GOOGLE_ADMISSION_SHEET_TAB="Admission Enquiries"

# Shared rate limiting for production/serverless deployments (Upstash Redis REST).
# Set both credentials in the hosting provider. Keep the token server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# false for local development; MUST be true in production to fail closed if Redis is unavailable.
UPSTASH_REDIS_REQUIRED=false

# Google Tag Manager (public container ID; defaults to GTM-WNP2CQQL)
NEXT_PUBLIC_GTM_ID=GTM-WNP2CQQL
